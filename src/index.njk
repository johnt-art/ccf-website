---
layout: base.njk
---
<section class="hero">
  <img src="{{ home.hero_photo | img }}" alt="">
  <div class="wrap">
    <p class="kicker">{{ home.hero_kicker }}</p>
    <h1>{{ home.hero_title }}</h1>
    <p>{{ home.intro }}</p>
    <p><a class="btn btn-gold" href="/vision/">Learn more about our vision</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap center">
    <p class="kicker">About us</p>
    <p class="lead" style="font-family:'Source Serif 4',Georgia,serif;font-size:1.45rem;color:var(--navy)">{{ home.about }}</p>
    <p><a class="btn btn-line" href="/photos/">See our ministry in pictures</a></p>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <h2>Get involved</h2>
    {% include "involved-cards.njk" %}
    <p class="center" style="margin-top:28px"><a class="btn" href="/calendar/">See what's coming up</a></p>
  </div>
</section>

{% include "testimonials.njk" %}

<section class="section alt">
  <div class="wrap split">
    <div>
      <h2>Get in touch</h2>
      <p class="lead">Have questions or want to get plugged in? Drop us a note and we'll get back to you.</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br><a href="sms:{{ site.phone_sms }}">{{ site.phone }}</a><br>{{ site.address }}</p>
    </div>
    <div class="panel">{% include "contact-form.njk" %}</div>
  </div>
</section>
